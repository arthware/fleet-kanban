#!/usr/bin/env python3
# desc: flag rogue in-progress cards — stalled, oversized, colliding, uncommitted, off-branch, struggling
"""
FLEET_DIR / FLEET_CLINE_HOME / FLEET_KANBAN_URL / FLEET_KANBAN_PORT are exported.
`fleet` is on PATH — call back into it if useful.

Why: driving a board overnight means repeatedly asking the same five questions about every running
card — is it still doing anything, has it grown beyond its card, is it fighting another card over the
same file, is its work committed or one crash away from being lost, and is it even on its own branch.
Doing that by hand is the repeat-work AGENTS.md says to turn into an xtool.

Liveness is derived from **git and the worktree**, never from sessions.json. That file has repeatedly
claimed cards were running when they were dead and dead when they were running; a card that is
genuinely working either dirties a file or lands a commit. A single `ps` sample is no better — it
flaps. So: mtime of the changed set, plus commit recency.

A flag is a prompt to look, not a verdict. A card mid-thought on a hard problem legitimately touches
nothing for a while; that is why STALLED is time-thresholded and reported, not acted on.

Exit status: 0 = nothing flagged, 1 = at least one flag (so a watchdog can gate on it), 2 = usage.

Usage:
  fleet xtools card-watch [--workspace <id>] [--stall-mins N] [--max-lines N] [--max-files N]
                          [--max-dirty N] [--json]
  fleet xtools card-watch                          # every board, human summary
  fleet xtools card-watch --workspace fleet-kanban-session-kinds
  fleet xtools card-watch --json                   # machine object for a watchdog
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

DENY_PATHS = (".fleet/cline/", "node_modules/", "dist/", ".env")


def cline_home() -> Path:
    home = os.environ.get("FLEET_CLINE_HOME")
    return Path(home) if home else Path.home() / "code/repos/tools/.fleet/cline"


def git(worktree: Path, *args: str) -> str:
    try:
        out = subprocess.run(
            ["git", "-C", str(worktree), *args],
            capture_output=True, text=True, timeout=30,
        )
        return out.stdout.strip() if out.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def registered_workspaces() -> set[str]:
    """Workspaces the runtime actually knows about — index.json is the registry.

    The workspaces dir is also full of test-fixture boards (project-*, managed-project, …) whose
    cards have no worktree and would otherwise flag as NO-WORKTREE forever. Registered-and-on-disk
    is the honest definition of a real board.
    """
    try:
        index = json.loads((cline_home() / "kanban" / "workspaces" / "index.json").read_text())
    except (OSError, json.JSONDecodeError):
        return set()
    return {
        wid
        for wid, entry in (index.get("entries") or {}).items()
        if isinstance(entry, dict) and entry.get("repoPath") and Path(entry["repoPath"]).is_dir()
    }


def in_progress_cards(workspace_dir: Path) -> list[dict]:
    try:
        board = json.loads((workspace_dir / "board.json").read_text())
    except (OSError, json.JSONDecodeError):
        return []
    cards = []
    for column in board.get("columns") or []:
        if column.get("id") != "in_progress":
            continue
        for key in ("tasks", "cards", "items"):
            for card in column.get(key) or []:
                if isinstance(card, dict) and card.get("id"):
                    cards.append(card)
    return cards


def find_worktree(card_id: str) -> Path | None:
    base = cline_home().parent / "cline" / "worktrees" / card_id
    if not base.is_dir():
        base = cline_home() / "worktrees" / card_id
    if not base.is_dir():
        return None
    for child in sorted(base.iterdir()):
        if (child / ".git").exists():
            return child
    return None


def newest_change_age_mins(worktree: Path, dirty: list[str]) -> float | None:
    """Minutes since the worktree last changed: newest dirty-file mtime, else last commit."""
    newest = 0.0
    for rel in dirty:
        try:
            newest = max(newest, (worktree / rel).stat().st_mtime)
        except OSError:
            continue
    if newest == 0.0:
        stamp = git(worktree, "log", "-1", "--format=%ct")
        if not stamp.isdigit():
            return None
        newest = float(stamp)
    return (time.time() - newest) / 60.0


def locate_transcript(agent_id: str, session_id: str, home_path: Path) -> Path | None:
    session_id = session_id.strip()
    if not session_id:
        return None

    if agent_id == "claude":
        projects_root = home_path / ".claude" / "projects"
        if projects_root.is_dir():
            for pdir in projects_root.iterdir():
                if pdir.is_dir():
                    candidate = pdir / f"{session_id}.jsonl"
                    if candidate.is_file():
                        return candidate
    elif agent_id == "codex":
        sessions_root = home_path / ".codex" / "sessions"
        if sessions_root.is_dir():
            suffix = f"-{session_id}.jsonl"
            for root, _, files in os.walk(str(sessions_root)):
                for f in files:
                    if f.startswith("rollout-") and f.endswith(suffix):
                        return Path(root) / f
    elif agent_id == "gemini":
        tmp_root = home_path / ".gemini" / "tmp"
        if tmp_root.is_dir():
            suffix8 = f"-{session_id[:8]}.jsonl"
            suffix_full = f"-{session_id}.jsonl"
            for pdir in tmp_root.iterdir():
                if pdir.is_dir():
                    chats_dir = pdir / "chats"
                    if chats_dir.is_dir():
                        for file in chats_dir.iterdir():
                            if file.is_file() and file.name.startswith("session-"):
                                if file.name.endswith(suffix8) or file.name.endswith(suffix_full):
                                    return file
    return None


def detect_struggle_from_transcript(path: Path) -> tuple[bool, list[str]]:
    """Analyzes a transcript file to detect if the agent is struggling/thrashing."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return False, []

    recent_calls = []
    consecutive_repeats = 0
    last_call_key = None
    last_call_name = None

    edit_tools = {"replace", "write_file", "mcp_pencil_batch_design", "patch", "mcp_pencil_replace_all_matching_properties"}

    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue

        calls = []
        rec_type = record.get("type")

        # Claude format
        if rec_type == "assistant" and isinstance(record.get("message"), dict):
            msg = record["message"]
            content = msg.get("content")
            if isinstance(content, list):
                for block in content:
                    if isinstance(block, dict) and block.get("type") == "tool_use" and isinstance(block.get("name"), str):
                        calls.append({"name": block["name"], "input": block.get("input")})

        # Codex format
        if rec_type == "response_item" and isinstance(record.get("payload"), dict):
            payload = record["payload"]
            p_type = payload.get("type")
            if p_type in ("function_call", "custom_tool_call") and isinstance(payload.get("name"), str):
                calls.append({"name": payload["name"], "input": payload.get("arguments") or payload.get("input")})

        for call in calls:
            inp_str = json.dumps(call["input"], sort_keys=True)
            file_edited = None
            if call["name"] in edit_tools and isinstance(call["input"], dict):
                file_edited = call["input"].get("file_path") or call["input"].get("filePath") or call["input"].get("path")

            key = f"{call['name']}:{inp_str}"
            if last_call_key == key:
                consecutive_repeats += 1
            else:
                consecutive_repeats = 0
            last_call_key = key
            last_call_name = call["name"]

            recent_calls.append({
                "name": call["name"],
                "input_str": inp_str,
                "file_edited": file_edited,
                "failed": False
            })
            if len(recent_calls) > 15:
                recent_calls.pop(0)

        result_text = None
        if rec_type == "user" and isinstance(record.get("message"), dict):
            msg = record["message"]
            content = msg.get("content")
            if isinstance(content, list):
                parts = []
                for block in content:
                    if isinstance(block, dict) and block.get("type") == "tool_result":
                        b_content = block.get("content")
                        if isinstance(b_content, str):
                            parts.append(b_content)
                        elif isinstance(b_content, list):
                            for sub in b_content:
                                if isinstance(sub, dict) and sub.get("type") == "text" and isinstance(sub.get("text"), str):
                                    parts.append(sub["text"])
                if parts:
                    result_text = "\n".join(parts)

        if rec_type == "response_item" and isinstance(record.get("payload"), dict):
            payload = record["payload"]
            p_type = payload.get("type")
            if p_type in ("function_call_output", "custom_tool_call_output"):
                output = payload.get("output")
                if isinstance(output, str):
                    result_text = output
                elif isinstance(output, dict) and isinstance(output.get("content"), str):
                    result_text = output["content"]

        if result_text is not None and recent_calls:
            lower = result_text.lower()
            failed = False
            if any(term in lower for term in ("error:", "failed:", "exception:", "exit code:", "command failed")):
                failed = True
            elif "fail" in lower and any(term in lower for term in ("tests", "spec")):
                failed = True

            if failed:
                recent_calls[-1]["failed"] = True

    reasons = []
    if consecutive_repeats >= 3 and last_call_name:
        reasons.append(f"Tool {last_call_name} was invoked with identical arguments 4 times consecutively")

    call_counts = {}
    for call in recent_calls:
        k = f"{call['name']}:{call['input_str']}"
        call_counts[k] = call_counts.get(k, 0) + 1
    for k, count in call_counts.items():
        if count >= 4:
            tool_name = k.split(":")[0]
            reasons.append(f"Tool {tool_name} was repeated with identical arguments {count} times recently")

    edit_counts = {}
    for call in recent_calls:
        if call["file_edited"]:
            edit_counts[call["file_edited"]] = edit_counts.get(call["file_edited"], 0) + 1
    for file, count in edit_counts.items():
        if count >= 5:
            reasons.append(f"File {file} was edited {count} times recently without resolution")

    total_calls = len(recent_calls)
    failed_calls = sum(1 for c in recent_calls if c["failed"])
    failure_rate = failed_calls / total_calls if total_calls >= 5 else 0.0
    if failure_rate >= 0.7:
        reasons.append(f"High recent tool failure rate of {failure_rate*100:.0f}% ({failed_calls}/{total_calls} failed)")

    return len(reasons) > 0, reasons


def inspect(card: dict, args, sessions: dict = None) -> dict:
    card_id = card["id"]
    worktree = find_worktree(card_id)
    row: dict = {
        "id": card_id,
        "title": (card.get("title") or "")[:44],
        "agent": card.get("agentId"),
        "base": card.get("baseRef"),
        "flags": [],
    }
    if worktree is None:
        row["flags"].append("NO-WORKTREE")
        return row

    row["worktree"] = str(worktree)
    row["branch"] = git(worktree, "rev-parse", "--abbrev-ref", "HEAD") or "?"

    porcelain = git(worktree, "status", "--porcelain", "-uall")
    dirty = [line[3:].strip() for line in porcelain.splitlines() if len(line) > 3]
    row["dirty"] = len(dirty)

    base = card.get("baseRef") or ""
    ahead = git(worktree, "rev-list", "--count", f"{base}..HEAD") if base else ""
    row["commits"] = int(ahead) if ahead.isdigit() else None

    changed: set[str] = set(dirty)
    lines = 0
    # Committed work vs base, PLUS work still in the worktree — a card sitting on 3000 uncommitted
    # lines is exactly the oversized card we want flagged, and it has no commits to measure yet.
    ranges = [f"{base}...HEAD"] if base else []
    for spec in (*ranges, "HEAD", "--cached"):
        stat = git(worktree, "diff", "--numstat", spec)
        for line in stat.splitlines():
            parts = line.split("\t")
            if len(parts) == 3:
                changed.add(parts[2])
                lines += sum(int(n) for n in parts[:2] if n.isdigit())
    row["files"] = len(changed)
    row["lines"] = lines
    row["_changed"] = sorted(changed)

    age = newest_change_age_mins(worktree, dirty)
    row["idle_mins"] = None if age is None else round(age, 1)

    # --- flags ---
    if age is not None and age > args.stall_mins:
        row["flags"].append(f"STALLED({int(age)}m)")
    if lines > args.max_lines or len(changed) > args.max_files:
        row["flags"].append(f"OVERSIZED({lines}L/{len(changed)}f)")
    if len(dirty) > args.max_dirty:
        row["flags"].append(f"UNCOMMITTED({len(dirty)}f)")
    if row["commits"] == 0 and age is not None and age > args.stall_mins:
        row["flags"].append("NO-COMMITS")
    if card_id not in row["branch"]:
        row["flags"].append(f"OFF-BRANCH({row['branch']})")
    denied = [f for f in changed if any(f.startswith(p) or f"/{p}" in f for p in DENY_PATHS)]
    if denied:
        row["flags"].append(f"GUARDRAIL({denied[0]})")

    # Struggle detection
    sessions = sessions or {}
    session = sessions.get(card_id) or {}
    agent_id = session.get("agentId") or card.get("agentId")
    agent_session_id = session.get("agentSessionId")
    if agent_id and agent_session_id:
        t_path = locate_transcript(agent_id, agent_session_id, Path.home())
        if t_path and t_path.is_file():
            struggling, reasons = detect_struggle_from_transcript(t_path)
            if struggling:
                row["flags"].append("STRUGGLING")
                row["struggle_reasons"] = reasons

    return row


def main() -> int:
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--workspace")
    ap.add_argument("--stall-mins", type=float, default=20.0)
    ap.add_argument("--max-lines", type=int, default=2000)
    ap.add_argument("--max-files", type=int, default=60)
    ap.add_argument("--max-dirty", type=int, default=40)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args()
    if args.help:
        print(__doc__.strip())
        return 0

    root = cline_home() / "kanban" / "workspaces"
    if not root.is_dir():
        print(f"card-watch: no workspaces dir at {root}", file=sys.stderr)
        return 2

    real = registered_workspaces()
    names = [args.workspace] if args.workspace else sorted(
        p.name for p in root.iterdir() if (p / "board.json").exists() and p.name in real
    )

    rows: list[dict] = []
    for name in names:
        workspace_dir = root / name
        sessions = {}
        try:
            sessions = json.loads((workspace_dir / "sessions.json").read_text())
        except Exception:
            pass
        for card in in_progress_cards(workspace_dir):
            row = inspect(card, args, sessions)
            row["workspace"] = name
            rows.append(row)

    # Cross-card collision: two running cards editing the same file.
    for i, a in enumerate(rows):
        for b in rows[i + 1:]:
            shared = set(a.get("_changed") or []) & set(b.get("_changed") or [])
            shared.discard("")
            if shared:
                a["flags"].append(f"COLLIDES({b['id']}:{sorted(shared)[0]})")
                b["flags"].append(f"COLLIDES({a['id']}:{sorted(shared)[0]})")

    for row in rows:
        row.pop("_changed", None)

    if args.json:
        print(json.dumps({"cards": rows}, indent=1))
    elif not rows:
        print("card-watch: no in-progress cards.")
    else:
        print(f"{'card':6} {'agent':7} {'idle':>6} {'cmts':>4} {'files':>5} {'lines':>6}  title")
        for r in rows:
            idle = "-" if r.get("idle_mins") is None else f"{r['idle_mins']:.0f}m"
            print(
                f"{r['id']:6} {str(r.get('agent'))[:7]:7} {idle:>6} "
                f"{str(r.get('commits') if r.get('commits') is not None else '-'):>4} "
                f"{str(r.get('files', '-')):>5} {str(r.get('lines', '-')):>6}  {r['title']}"
            )
        flagged = [r for r in rows if r["flags"]]
        if flagged:
            print("\nFLAGS (look, don't assume):")
            for r in flagged:
                print(f"  {r['id']}  {' '.join(r['flags'])}")
                if "struggle_reasons" in r:
                    for reason in r["struggle_reasons"]:
                        print(f"       - {reason}")
        else:
            print("\nno flags.")

    return 1 if any(r["flags"] for r in rows) else 0


if __name__ == "__main__":
    sys.exit(main())

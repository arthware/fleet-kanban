#!/usr/bin/env bash
# desc: emit a ready-to-paste "## Prior art" block of commit SHAs that touched the given files/topic (token-efficient card priming)
set -euo pipefail
# FLEET_DIR / FLEET_CLINE_HOME / FLEET_KANBAN_URL / FLEET_KANBAN_PORT are exported.
# `fleet` is on PATH — call back into it if useful.
#
# Why: when a card MODIFIES existing code, its prompt should carry a
#   ## Prior art (read with `git show <sha>` before starting)
#   - <sha> — <what it did>
# section (see fleet-kanban/AGENTS.md). Reading the actual prior diff is cheaper
# and more consistent than an impl agent re-deriving the tree with a broad sweep.
# This tool derives those SHAs deterministically (git only, ~0 model tokens) so
# generating the block is a one-liner instead of hand-archaeology.
#
# Usage:
#   fleet xtools prior-art [-C <repo-dir>] [-n <count>] [--grep <term>] <pathspec>...
#   fleet xtools prior-art --repo fleet-kanban web-ui/src/components/board-card.tsx
#   fleet xtools prior-art -C fleet-kanban --grep "token usage" web-ui/src/utils
#
#   <pathspec>...  files/dirs/globs the card will touch (git pathspec, relative to repo dir)
#   -C <dir>       repo directory to run git in (default: cwd)
#   --repo <name>  shorthand for -C <cwd>/<name> if that dir exists, else -C <name>
#   -n <count>     max commits (default 6)
#   --grep <term>  also/instead match commit subject/body (topic search when you lack exact paths)

repo_dir="."
count=6
grep_term=""
paths=()

while [[ $# -gt 0 ]]; do
        case "$1" in
                -C) repo_dir="$2"; shift 2 ;;
                --repo)
                        # Resolve a repo NAME independent of cwd: prefer an existing dir as
                        # given, else anchor to the fleet workspace root (parent of FLEET_DIR,
                        # e.g. .../tools/<name>), else a cwd-relative dir, else look up in the
                        # board's workspace list if available.
                        name="$2"
                        ws_root="${FLEET_DIR:+$FLEET_DIR/..}"
                        resolved_path=""
                        if [[ -n "${FLEET_KANBAN_PORT:-}" ]]; then
                                # Query the board for the workspace list to resolve epic workspaces
                                resolved_path="$(curl -s "http://127.0.0.1:${FLEET_KANBAN_PORT}/api/trpc/projects.list" \
                                        | node -e '
                                                let s="";
                                                process.stdin.on("data", d => s += d).on("end", () => {
                                                        try {
                                                                const name = process.argv[1];
                                                                const data = JSON.parse(s);
                                                                const projs = data?.result?.data?.projects || [];
                                                                const p = projs.find(x => x.id === name || x.name === name || x.path.endsWith("/" + name));
                                                                if (p) process.stdout.write(p.path);
                                                        } catch (e) {}
                                                });
                                        ' "$name" 2>/dev/null)"
                        fi

                        if [[ -n "$resolved_path" ]]; then
                                repo_dir="$resolved_path"
                        elif [[ -d "$name" ]]; then repo_dir="$name"
                        elif [[ -n "$ws_root" && -d "$ws_root/$name" ]]; then repo_dir="$ws_root/$name"
                        elif [[ -d "./$name" ]]; then repo_dir="./$name"
                        else repo_dir="$name"; fi
                        shift 2 ;;
                -n) count="$2"; shift 2 ;;
                --grep) grep_term="$2"; shift 2 ;;
                -h|--help) sed -n '2,25p' "$0"; exit 0 ;;
                --) shift; while [[ $# -gt 0 ]]; do paths+=("$1"); shift; done ;;
                *) paths+=("$1"); shift ;;
        esac
done

if ! git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1; then
        echo "prior-art: '$repo_dir' is not a git repo (use -C <dir> or --repo <name>)" >&2
        exit 1
fi

if [[ ${#paths[@]} -eq 0 && -z "$grep_term" ]]; then
        echo "prior-art: give at least one <pathspec> or --grep <term>" >&2
        exit 1
fi

# Build git log args. Format: <short-sha>\t<subject>
log_args=(--no-pager -C "$repo_dir" log "-n" "$count" "--format=%h%x09%s")
[[ -n "$grep_term" ]] && log_args+=("--grep=$grep_term" "-i")

# bash 3.2 (macOS default) has no `mapfile`; read line-by-line instead.
if [[ ${#paths[@]} -gt 0 ]]; then
        out="$(git "${log_args[@]}" -- "${paths[@]}" 2>/dev/null)"
else
        out="$(git "${log_args[@]}" 2>/dev/null)"
fi

if [[ -z "$out" ]]; then
        echo "prior-art: no commits found for the given paths/term in '$repo_dir'" >&2
        exit 1
fi

echo '## Prior art (read with `git show <sha>` before starting)'
while IFS=$'\t' read -r sha subject; do
        [[ -z "$sha" ]] && continue
        echo "- ${sha} — ${subject}"
done <<< "$out"
